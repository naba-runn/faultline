# .env (repo root) — read by docker-compose.yml only. Separate from
# server/.env, which the API process reads directly when NOT run via
# Docker (npm run dev). Compose sets MONGODB_URI/REDIS_URL itself
# (pointing at the mongo/redis service names), so those two don't need
# to be duplicated here.

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@faultline.dev
